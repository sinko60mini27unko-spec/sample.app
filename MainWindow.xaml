<Window x:Class="ScheduleTasksApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程＋タスク管理" Height="560" Width="980" MinHeight="500" MinWidth="900">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="日付" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="左で日付を選択すると右にタスクを表示" Foreground="#666" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="今日を追加" Width="100" Margin="0,0,8,0" Click="AddTodayDate_Click"/>
                    <Button Content="日付を削除" Width="100" Click="DeleteDate_Click"/>
                </StackPanel>

                <ListBox x:Name="DateListBox"
                         DisplayMemberPath="DisplayText"
                         SelectionChanged="DateListBox_SelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
            <DockPanel>
                <TextBlock x:Name="SelectedDateText"
                           DockPanel.Dock="Top"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="日付を選択してください" />

                <DataGrid x:Name="TasksDataGrid"
                          Margin="0,10,0,10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="TasksDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="担当者" Binding="{Binding Assignee}" Width="*"/>
                        <DataGridCheckBoxColumn Header="完了" Binding="{Binding IsDone}" Width="80"/>
                        <DataGridTextColumn Header="メモ" Binding="{Binding Note}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="タスク編集" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="タイトル"/>
                        <TextBox x:Name="TitleTextBox" Grid.Column="1" Margin="6,0,12,0"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="担当者"/>
                        <TextBox x:Name="AssigneeTextBox" Grid.Column="3" Margin="6,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="メモ"/>
                        <TextBox x:Name="NoteTextBox" Grid.Column="1" Margin="6,0,12,0"/>
                        <CheckBox x:Name="IsDoneCheckBox" Grid.Column="2" Content="完了" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="追加" Width="90" Margin="0,0,8,0" Click="AddTask_Click"/>
                        <Button Content="更新" Width="90" Margin="0,0,8,0" Click="UpdateTask_Click"/>
                        <Button Content="削除" Width="90" Click="DeleteTask_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
